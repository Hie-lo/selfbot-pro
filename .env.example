# ── ربات کنترلی ──
BOT_TOKEN=123456:AAA-your-bot-token
ADMIN_TELEGRAM_ID=123456789

# ── Telegram API (my.telegram.org) ──
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=selfbot_pro
DB_USER=selfbot
DB_PASS=strong_password

# ── رمزنگاری session (Fernet) ──
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── پرداخت کارت به کارت ──
CARD_NUMBER=6037-0000-0000-0000
CARD_HOLDER=نام صاحب کارت
BANK_NAME=بانک ملی
RECEIPT_MAX_MB=10

# ── Recents: جلوگیری از آلوده شدن لیست استیکر/گیف ──
# document = استیکر/گیف به‌صورت فایل ارسال می‌شود (پیش‌فرض، کاملاً ایمن)
# cleanup  = استیکر/گیف واقعی + حذف خودکار از Recents
# off      = بدون محافظت
CLEAN_RECENTS_MODE=document

# ── فوروارد (سرعت و مقاومت در برابر محدودیت تلگرام) ──
# سرعت: safe | balanced | fast | max  (پیشنهاد: balanced)
# موتور خودش با بازخورد FloodWait تنظیم می‌شود
FORWARD_SPEED=balanced
# چند پیام همزمان (0 = از پریست)
FORWARD_CONCURRENCY=0
FORWARD_BATCH_SIZE=20
FORWARD_BATCH_PAUSE=1.0
FORWARD_MAX_FLOOD_WAIT=86400
# فاز جمع‌آوری کش (خواندن تاریخچه — سبک‌تر از ارسال)
FORWARD_CACHE_BATCH=100
FORWARD_CACHE_PAUSE=0.15
# توجه: FORWARD_MSG_PAUSE قدیمی است؛ اگر مقدار کندی بگذاری سرعت پایین می‌ماند
# (در پنل هم هشدار داده می‌شود)
# حالت کش: 1 = اول همه پیام‌ها روی سرور ذخیره شوند، بعد ارسال (مقاوم به قطع دسترسی)
FORWARD_CACHE_MODE=1
# دانلود مدیا و نگه‌داشتن روی دیسک سرور (فضا مصرف می‌کند)
FORWARD_CACHE_CAPTURE_MEDIA=0
FORWARD_CACHE_MAX_GB=5
FORWARD_CACHE_MEDIA_MAX_MB=100

# ── امنیت و ظرفیت ──
MAX_LOGIN_ATTEMPTS=3
LOGIN_TIMEOUT_SECONDS=120
MAX_CLIENTS_PER_SERVER=20

# ── کنترل دسترسی زنده (watchdog) ──
# هر چند ثانیه اشتراک/مسدودی/سلامت اتصال کاربران متصل بررسی شود
ACCESS_CHECK_INTERVAL=60
# هر چند دور، اعتبار session از خود تلگرام پرسیده شود
AUTH_CHECK_EVERY=5
# چند روز قبل از انقضا به کاربر یادآوری شود (0 = خاموش)
EXPIRY_WARN_DAYS=3


# ═══════ پاسخ هوشمند (AI) ═══════
# ⚠️ آدرس را دستی تایپ کن؛ اگر از چت کپی کنی، تلگرام/مرورگر آن را به شکل
#    لینک مارک‌داون [https://…](https://…) درمی‌آورد و سرویس کار نمی‌کند.
#    برای تست: python tools/ai_check.py
# چند سرویس پشت سر هم با چرخش خودکار کلید. نمونه‌ها (فقط یکی را لازم داری):
#
# ── انتخاب مدل: هوشمندی بیشتر = خطای معنایی/املایی کمتر (و رایگان هم هست) ──
# مدل‌های ۸B سریع‌اند ولی در فارسی بیشتر بی‌ربط می‌گویند و غلط املایی دارند.
# مدل‌های بزرگ‌تر رایگان، هم دقیق‌ترند هم هزینه‌شان صفر است:
#
#   meta-llama/llama-3.3-70b-instruct:free   ← بهترین گزینه‌ی فارسی، توصیه‌ی اول
#   qwen/qwen3-next-80b-a3b-instruct:free    ← فارسی خوب و پایدار
#   openai/gpt-oss-120b:free                 ← قوی برای گفت‌وگوی منطقی
#   nvidia/nemotron-3-super-120b-a12b:free   ← پنجره‌ی بزرگ
#
# نکته‌ی هزینه: مدل‌های :free کاملاً رایگان‌اند ولی سقف دارند
# (OpenRouter: حدود ۲۰ درخواست در دقیقه و ۵۰ در روز). برای حجم بالا،
# دو سرویس را با priority بگذار تا خودکار بین‌شان بچرخد (نمونه‌ی زیر).
#
# OpenRouter (مدل بزرگ رایگان — توصیه می‌شود):
# AI_PROVIDERS=[{"name":"openrouter","kind":"openai","base_url":"https://openrouter.ai/api/v1","model":"meta-llama/llama-3.3-70b-instruct:free","keys":["sk-or-..."],"priority":0},{"name":"groq","kind":"openai","base_url":"https://api.groq.com/openai/v1","model":"llama-3.3-70b-versatile","keys":["gsk_..."],"priority":1}]
#
# Groq (رایگان و سریع):
# AI_PROVIDERS=[{"name":"groq","kind":"openai","base_url":"https://api.groq.com/openai/v1","model":"llama-3.1-8b-instant","keys":["gsk_..."],"priority":0}]
#
# Google Gemini:
# AI_PROVIDERS=[{"name":"gemini","kind":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta","model":"gemini-1.5-flash","keys":["AIza..."]}]
#
# حالت ساده (یک سرویس):
# AI_KIND=openai
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_API_KEY=sk-or-...
