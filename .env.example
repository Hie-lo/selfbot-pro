# ── ربات کنترلی ──
BOT_TOKEN=123456:AAA-your-bot-token
ADMIN_TELEGRAM_ID=123456789

# ── Telegram API (my.telegram.org) ──
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=selfbot_pro
DB_USER=selfbot
DB_PASS=strong_password

# ── رمزنگاری session (Fernet) ──
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── پرداخت کارت به کارت ──
CARD_NUMBER=6037-0000-0000-0000
CARD_HOLDER=نام صاحب کارت
BANK_NAME=بانک ملی
RECEIPT_MAX_MB=10

# ── Recents: جلوگیری از آلوده شدن لیست استیکر/گیف ──
# document = استیکر/گیف به‌صورت فایل ارسال می‌شود (پیش‌فرض، کاملاً ایمن)
# cleanup  = استیکر/گیف واقعی + حذف خودکار از Recents
# off      = بدون محافظت
CLEAN_RECENTS_MODE=document

# ── فوروارد (سرعت و مقاومت در برابر محدودیت تلگرام) ──
# سرعت: safe | balanced | fast | max  (پیشنهاد: balanced)
# موتور خودش با بازخورد FloodWait تنظیم می‌شود
FORWARD_SPEED=balanced
# چند پیام همزمان (0 = از پریست)
FORWARD_CONCURRENCY=0
FORWARD_BATCH_SIZE=20
FORWARD_BATCH_PAUSE=1.0
FORWARD_MAX_FLOOD_WAIT=86400
# فاز جمع‌آوری کش (خواندن تاریخچه — سبک‌تر از ارسال)
FORWARD_CACHE_BATCH=100
FORWARD_CACHE_PAUSE=0.15
# توجه: FORWARD_MSG_PAUSE قدیمی است؛ اگر مقدار کندی بگذاری سرعت پایین می‌ماند
# (در پنل هم هشدار داده می‌شود)
# حالت کش: 1 = اول همه پیام‌ها روی سرور ذخیره شوند، بعد ارسال (مقاوم به قطع دسترسی)
FORWARD_CACHE_MODE=1
# دانلود مدیا و نگه‌داشتن روی دیسک سرور (فضا مصرف می‌کند)
FORWARD_CACHE_CAPTURE_MEDIA=0
FORWARD_CACHE_MAX_GB=5
FORWARD_CACHE_MEDIA_MAX_MB=100

# ── امنیت و ظرفیت ──
MAX_LOGIN_ATTEMPTS=3
LOGIN_TIMEOUT_SECONDS=120
MAX_CLIENTS_PER_SERVER=20

# ── کنترل دسترسی زنده (watchdog) ──
# هر چند ثانیه اشتراک/مسدودی/سلامت اتصال کاربران متصل بررسی شود
ACCESS_CHECK_INTERVAL=60
# هر چند دور، اعتبار session از خود تلگرام پرسیده شود
AUTH_CHECK_EVERY=5
# چند روز قبل از انقضا به کاربر یادآوری شود (0 = خاموش)
EXPIRY_WARN_DAYS=3

# ── کارایی و ظرفیت ──
# قفل «فقط یک نمونه» با PostgreSQL (جلوگیری از باطل شدن sessionها) — خاموش نکنید
INSTANCE_LOCK=1
# اگر نمونه‌ی قبلی در حال بسته شدن است، چند ثانیه صبر شود
INSTANCE_LOCK_WAIT=30
# پذیرش اکانت جدید: حداقل RAM آزاد (MB)، سقف RAM پروسه (MB، 0=خاموش)،
# سقف تأخیر حلقه برای ورود جدید (ms)
MIN_FREE_MEM_MB=150
MAX_RSS_MB=0
LAG_LIMIT_MS=500
# چند اکانت همزمان هنگام روشن شدن وصل شوند
STARTUP_CONCURRENCY=4
# سقف سراسری کارهای سنگین (کل سرور)
GOV_FORWARD_JOBS=3
GOV_FFMPEG=2
GOV_DOWNLOADS=4
GOV_CAPTURE=4
# FloodWait طولانی‌تر از این (ثانیه) → ظرفیت فوروارد موقتاً به بقیه داده شود
GOV_YIELD_ON_FLOOD=60
USE_UVLOOP=1
LOG_MAX_MB=10
LOG_BACKUPS=5

# ── ضدحذف / ضدویرایش ──
# سقف حجم و سن کش پی‌وی برای هر اکانت
PV_CACHE_MAX_MB=8
PV_CACHE_MAX_AGE_HOURS=168
# حذف بیشتر از این تعداد در یک لحظه → گزارش خلاصه + فایل
PV_BURST_THRESHOLD=5
# گاوصندوق مدیا (دانلود رمزنگاری‌شده‌ی مدیای کوچک طرف مقابل)
PV_VAULT_ENABLED=1
PV_VAULT_TYPES=photo,voice,round
PV_VAULT_MAX_MB=5
PV_VAULT_QUOTA_MB=50
PV_VAULT_TTL_HOURS=48
# بازخوانی تاریخچه‌ی پی‌وی بعد از ری‌استارت/روشن کردن (پوشش ضدحذف برای پیام‌های قبل از ری‌استارت)
PV_WARMUP_ENABLED=1
PV_WARMUP_HOURS=48
PV_WARMUP_CHATS=50
# حداکثر ۱۰۰ (یک درخواست برای هر چت)
PV_WARMUP_MESSAGES=100
# چند مدیای اخیر در بازخوانی داخل گاوصندوق دانلود شوند (0 = هیچ)
PV_WARMUP_VAULT_FILES=20
